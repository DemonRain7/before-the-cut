# NEVER USED YET. Wrangler is not installed on the development machine and nothing is deployed.
# Copy to "wrangler.toml" when you are ready to try a Cloudflare Worker deployment.
# If the instructor's Cloudflare AI-worker foundation is available, start from that instead and
# move src/core.mjs into it.

name = "before-the-cut-agent"
main = "src/worker.mjs"
compatibility_date = "2026-11-01"

[vars]
BTC_PROVIDER = "mock"
BTC_MODEL = "gemini-3.5-flash-lite"

# Secrets never go in this file. Set them with:
#   wrangler secret put GEMINI_API_KEY
